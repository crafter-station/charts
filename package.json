{
  "name": "@crafter/charts",
  "version": "0.1.0",
  "description": "Terminal-native charts. Sparklines, line, bar, scatter — composable, typed, zero deps.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "check": "bunx --bun @biomejs/biome check --write .",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["cli", "charts", "terminal", "sparkline", "ascii", "braille", "tui"],
  "author": "Crafter Station",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/crafter-station/charts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
